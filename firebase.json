{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "admin.html",
      "admin.js",
      "background.js",
      "content.js",
      "manifest.json",
      "popup.html",
      "popup.js",
      "firebase-firestore.js"
    ],
    "rewrites": [
      {
        "source": "/dashboard",
        "destination": "/dashboard.html"
      },
      {
        "source": "/dashboard/**",
        "destination": "/dashboard.html"
      },
      {
        "source": "**",
        "destination": "/landing.html"
      }
    ]
  }
}
